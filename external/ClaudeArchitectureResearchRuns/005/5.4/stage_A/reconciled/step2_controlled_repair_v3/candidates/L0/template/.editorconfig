# Level 3 Project · enforcement asset: deterministic formatting and code style
# (style policy: .claude/rules/2-technology/csharp.md)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css,js,mjs}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
# Unused or redundant usings in changed files (reported during build with EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0005.severity = warning

# Type inference
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern syntax as suggestions only (no mechanical modernization)
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_primary_constructors = true:silent

# Braces and expression bodies
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent

# Naming: PascalCase types and members, camelCase parameters, Async suffix
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, record, method, property, event, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = suggestion

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_rule.interfaces_prefix_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefix_i.style = prefix_i
dotnet_naming_rule.interfaces_prefix_i.severity = suggestion

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_rule.parameters_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_camel.style = camel_case
dotnet_naming_rule.parameters_camel.severity = suggestion

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = suggestion
# Private-field naming follows the repository's established convention (not enforced here).
