<Project>
  <!-- NuGet Central Package Management: every package version lives here; project files use versionless
       PackageReference entries. Add or update versions only through the add-dependency workflow
       (latest stable compatible version, verified at install time). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
