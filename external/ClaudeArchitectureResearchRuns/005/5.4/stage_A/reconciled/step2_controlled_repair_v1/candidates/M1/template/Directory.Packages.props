<Project>
  <!--
    NuGet Central Package Management (.claude/rules/dependencies.md).
    PackageVersion entries are added by the add-dependency workflow with the latest stable
    compatible version; project files keep versionless PackageReference entries.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
