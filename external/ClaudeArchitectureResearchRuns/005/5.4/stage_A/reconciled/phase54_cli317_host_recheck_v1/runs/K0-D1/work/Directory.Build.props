<!-- Kind: ENF | Scope: backend | Owner: shared .NET build settings for every project under this directory (decisions D-03, D-17) | Loading: MSBuild -->
<Project>
  <!-- Genuinely shared settings only; project-specific settings stay in their own project files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
