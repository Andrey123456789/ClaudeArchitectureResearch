<Project>
  <!--
    Repository-level shared .NET build settings (docs/technology-stack.md, Backend Platform).
    Keep only genuinely shared settings here; project-specific settings stay in the owning .csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
