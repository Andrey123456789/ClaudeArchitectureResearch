<!--
  NuGet Central Package Management.
  Policy: .claude/rules/dependencies.md. Add or update versions through the
  add-dependency workflow; project files reference packages without versions.
  Checked by .claude/scripts/check-manifests.mjs.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- <PackageVersion Include="Package.Id" Version="x.y.z" /> -->
  </ItemGroup>
</Project>
