set oracle_relation=PARTIALLY_ENTAILED
set domain=WORKFLOW_ENFORCEMENT
set strength_vs_canonical=STRONGER
set extra_fragment_kind=EXTRA_WORKFLOW
set extra_fragment=Limits on what a security scan may recommend, and a preference for the smallest secure change.
set distinguishing_scenario=A scan report recommends blanket field encryption as optional hardening and nothing is implemented: GOV-013, GOV-014, SEC-006 and SEC-008 hold; M1's line does not.
