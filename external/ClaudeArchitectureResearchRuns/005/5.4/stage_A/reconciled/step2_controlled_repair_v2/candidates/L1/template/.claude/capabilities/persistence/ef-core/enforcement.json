{
  "$comment": "Facet persistence.enforcement (Level 2, capability persistence/ef-core; binds architecture/clean-architecture path globs). Read by .claude/scripts/check-architecture.mjs and .claude/hooks/stop-cochange.mjs.",
  "persistencePackagePrefixes": ["Microsoft.EntityFrameworkCore"],
  "forbiddenInRoles": ["domain-model", "use-case-layer"],
  "packageOwner": ".claude/rules/2-technology/persistence/access.md",
  "cochange": {
    "modelRoles": ["domain-model"],
    "modelPathGlobs": ["backend/*.Infrastructure/Persistence/Configurations/**"],
    "seederPathGlobs": ["backend/*.Infrastructure/Persistence/Seeding/**"],
    "migrationPathGlobs": ["backend/*.Infrastructure/Persistence/Migrations/**"],
    "owner": "persistence.workflow (.claude/capabilities/persistence/ef-core/workflow.md)"
  }
}
