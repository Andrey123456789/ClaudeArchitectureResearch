# Kind: ENF | Scope: common | Owner: deterministic formatting and code-style configuration (conventions: .claude/rules/backend/csharp.md) | Loading: IDE, dotnet format, build analyzers
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css,csproj,props,targets,slnx,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
# IDE0005: unnecessary using directives (completion check: .claude/skills/verify/SKILL.md)
dotnet_diagnostic.IDE0005.severity = warning

# Type inference
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_elsewhere = false:silent

# Modern syntax where it reads better
csharp_style_prefer_primary_constructors = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Braces and layout
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion

# Naming (conventions: .claude/rules/backend/csharp.md)
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_pascal_case.severity = suggestion

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_rule.parameters_and_locals_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_camel_case.severity = suggestion

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = async_suffix
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
