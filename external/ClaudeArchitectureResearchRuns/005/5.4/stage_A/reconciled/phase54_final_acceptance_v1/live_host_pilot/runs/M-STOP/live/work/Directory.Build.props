<!--
  Shared .NET build settings for every project in this repository.
  Owner: docs/technology-stack.md (solution and build defaults).
  Keep project-specific settings in the owning .csproj file.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Surfaces .editorconfig code-style diagnostics (warning severity) during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
