  "policy_id": "SEC-014",
  "dims": [
   "D1 when a required security control cannot be configured correctly, fail visibly at startup/configuration rather than fall back insecurely"
  ],
  "label": "PARTIAL_PARITY_WITH_DELTA",
  "same": "All six place the rule in the same always-relevant security rule: M security.md:117-118, M1 security.md:112-113, L0 security-principles.md:53, L1 security.md:45, K0 common/security.md:49, K1 common/security.md:33; scan references in all six list the same dangerous fallbacks (auth silently disabled, plaintext without a key, allow-all on provider failure).",
  "diffs": [
   {
    "dim": "D1",
    "axis": "NORMATIVE",
    "kind": "TRUE_NORMATIVE_VARIANCE",
    "material": false,
    "tiers": [
     [
      "K0",
      "K1"
     ],
     [
      "M",
      "M1",
      "L0",
      "L1"
     ]
    ],
    "what": "K0 'must not fall back to an insecure mode; prefer visible ... failure' and K1 'must fail visibly ... instead of falling back' forbid the insecure fallback outright; M, M1, L0 and L1 keep the canonical 'prefer a visible ... failure over an insecure fallback'. A task that tempts a convenience fallback (for example disabling authentication when its configuration is missing in Development) is forbidden in K0/K1 and strongly disfavoured, but not categorically forbidden, in the other four.",
