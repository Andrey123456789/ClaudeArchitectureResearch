# Repository formatting and code-style configuration.
# Read by IDEs, `dotnet format`, and the .NET analyzers (EnforceCodeStyleInBuild).
# Conventions owner: .claude/rules/coding-style.md.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,xml,slnx,config}]
indent_size = 2

[*.{ts,js,mjs,html,scss,css}]
indent_size = 2
quote_type = single

[*.{cs,csx}]
indent_size = 4

# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
# Unused or redundant usings (verified for changed files by the verify workflow).
# Note: reporting IDE0005 during command-line builds also requires
# <GenerateDocumentationFile>true</GenerateDocumentationFile>.
dotnet_diagnostic.IDE0005.severity = warning

# Namespaces and files
csharp_style_namespace_declarations = file_scoped:suggestion

# var: when the type is apparent; explicit types elsewhere are fine
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_elsewhere = false:silent

# Qualification
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Naming: interfaces start with I
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begin_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begin_with_i.required_prefix = I
dotnet_naming_style.begin_with_i.capitalization = pascal_case

# Naming: async methods end with Async (framework/interface contracts may differ)
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# Naming: types and non-field members use PascalCase
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case_style
dotnet_naming_rule.types_and_members_pascal.severity = suggestion
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Naming: parameters and locals use camelCase
# (private-field naming follows the repository's established convention)
dotnet_naming_rule.parameters_and_locals_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_camel.style = camel_case_style
dotnet_naming_rule.parameters_and_locals_camel.severity = suggestion
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case_style.capitalization = camel_case
