# Repository-wide formatting and code-style configuration (deterministic enforcement).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion
# Unused or redundant using directives in changed files must be removed (verify workflow)
dotnet_diagnostic.IDE0005.severity = warning

# var: when the type is apparent; explicit type when it aids clarity
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent

# Modern syntax where it improves clarity (suggestions only)
csharp_style_prefer_primary_constructors = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Braces and layout
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

# Naming: PascalCase types and members, camelCase parameters and locals, I-prefixed interfaces
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = suggestion

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = suggestion

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_rule.parameters_and_locals_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_camel.style = camel_case
dotnet_naming_rule.parameters_and_locals_camel.severity = suggestion

# Async methods end with "Async" unless a framework or existing contract prevents it
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = suggestion
