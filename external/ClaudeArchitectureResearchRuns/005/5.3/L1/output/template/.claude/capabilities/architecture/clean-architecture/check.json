{
  "$comment": "Facet architecture.check (Level 1, capability architecture/clean-architecture): role-to-project placement data. Read by .claude/scripts/check-architecture.mjs and .claude/hooks/*. Owner of the rules it checks: .claude/rules/1-architecture/frame/boundaries.md. Technology package data: architecture.enforcement.",
  "backendRoot": "backend",
  "forbiddenTopLevelDirectories": ["tests"],
  "roles": {
    "domain-model": { "projectPattern": "\\.Domain$", "mayReference": [] },
    "use-case-layer": { "projectPattern": "\\.Application$", "mayReference": ["domain-model"] },
    "implementation-layer": { "projectPattern": "\\.Infrastructure$", "mayReference": ["use-case-layer", "domain-model"] },
    "entry-point": { "projectPattern": "\\.Api$", "mayReference": ["use-case-layer", "implementation-layer", "domain-model"] }
  },
  "innerRoles": ["domain-model", "use-case-layer"],
  "testRoles": {
    "domain-tests": { "projectPattern": "\\.Domain\\.Tests$", "typicalReferences": ["domain-model"] },
    "use-case-tests": { "projectPattern": "\\.Application\\.Tests$", "typicalReferences": ["use-case-layer", "domain-model"] },
    "implementation-tests": { "projectPattern": "\\.Infrastructure\\.Tests$", "typicalReferences": ["implementation-layer", "use-case-layer", "domain-model"] },
    "integration-tests": { "projectPattern": "\\.IntegrationTests$", "typicalReferences": ["entry-point"] }
  },
  "rolePathGlobs": {
    "domain-model": ["backend/*.Domain/**"],
    "use-case-layer": ["backend/*.Application/**"],
    "implementation-layer": ["backend/*.Infrastructure/**"],
    "entry-point": ["backend/*.Api/**"],
    "tests": ["backend/*Tests/**"]
  }
}
