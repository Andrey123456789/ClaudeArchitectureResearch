# Level: 2 Technology · Owns: deterministic formatting and analyzer severities · Enforcement asset
# Policy owner: .claude/rules/2-technology/csharp.md (conventions follow this file and the existing code)
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css,js,mjs}]
indent_size = 2

[*.{csproj,props,targets,xml,slnx,config}]
indent_size = 2

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Unused or redundant usings in changed files (enforced on build with EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0005.severity = warning

# var preference (guidance level; an explicit type stays fine when it reads better)
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_elsewhere = true:silent

# Naming: PascalCase for types and members, I-prefix for interfaces, Async suffix for awaitable methods
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_rule.interfaces_begin_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.async_methods_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_with_async.style = suffix_async
dotnet_naming_rule.async_methods_end_with_async.severity = suggestion
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.suffix_async.required_suffix = Async
dotnet_naming_style.suffix_async.capitalization = pascal_case

dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = suggestion
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal_case.capitalization = pascal_case
