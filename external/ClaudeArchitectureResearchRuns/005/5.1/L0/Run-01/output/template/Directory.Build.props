<!-- Level: 3 Project · Owns: repository-wide .NET build settings · Enforcement asset (policy: .claude/rules/3-project/decisions.md) -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Surfaces .editorconfig code-style diagnostics (for example IDE0005 unused usings) during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 on build; CS1591 (missing XML comments) is not a project requirement. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
