<!--
  Owns: NuGet Central Package Management versions.
  Scope: backend, backend-tests. Loads: imported automatically by NuGet/MSBuild.
  Add entries only through the add-dependency workflow, which resolves the latest
  stable compatible version at install time (.claude/rules/dependencies.md).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- <PackageVersion Include="FluentValidation" Version="x.y.z" /> -->
  </ItemGroup>
</Project>
