<!--
  Owns: shared .NET build settings for every project in the repository.
  Scope: backend, backend-tests. Loads: imported automatically by MSBuild.
  Keep project-specific settings in their own .csproj (docs/technology-stack.md).
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Apply .editorconfig code-style severities (for example IDE0005, unused usings) during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 is only reported at build time when documentation generation is on; -->
    <!-- CS1591 (missing XML comments) is suppressed because XML docs are optional. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
