<!-- Owner: NuGet Central Package Management — the single place for package versions | Scope: backend | Loads: MSBuild / NuGet restore | Enforced: NuGet NU1008 for versioned project references, .claude/scripts/check-dependencies.mjs; policy in .claude/rules/dependencies.md -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Add <PackageVersion Include="Package.Id" Version="x.y.z" /> entries only through
      the add-dependency workflow (.claude/skills/add-dependency/SKILL.md).
      No versions are pre-pinned: they are resolved when a package is first needed.
    -->
  </ItemGroup>
</Project>
