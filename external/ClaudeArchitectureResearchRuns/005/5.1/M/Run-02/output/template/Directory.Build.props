<!-- Owner: shared .NET build settings for every project in the repository | Scope: backend | Loads: MSBuild (all projects below this directory) | Enforced: build; policy in docs/technology-stack.md § Backend -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Report known vulnerabilities of direct and transitive packages during restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
