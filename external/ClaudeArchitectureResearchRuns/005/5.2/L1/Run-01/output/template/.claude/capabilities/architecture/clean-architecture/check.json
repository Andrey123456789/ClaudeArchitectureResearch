{
  "$comment": "Level: 1-architecture | Capability: architecture/clean-architecture (architecture.check) | Owns: project classification and allowed project references for the Clean Architecture frame | Read by .claude/scripts/check-architecture.cjs and .claude/hooks/stop-co-change.cjs",
  "backendRoot": "backend",
  "projects": [
    { "layer": "Domain", "role": "domain model", "suffix": ".Domain", "mayReference": [] },
    { "layer": "Application", "role": "use-case unit", "suffix": ".Application", "mayReference": ["Domain"] },
    { "layer": "Infrastructure", "role": "adapter", "suffix": ".Infrastructure", "mayReference": ["Application", "Domain"] },
    { "layer": "Api", "role": "entry point", "suffix": ".Api", "mayReference": ["Application", "Infrastructure", "Domain"] }
  ],
  "testProjects": [
    { "role": "test-project role", "suffix": ".Domain.Tests", "mayReference": ["Domain"] },
    { "role": "test-project role", "suffix": ".Application.Tests", "mayReference": ["Application", "Domain"] },
    { "role": "test-project role", "suffix": ".Infrastructure.Tests", "mayReference": ["Infrastructure", "Application", "Domain"] },
    { "role": "test-project role", "suffix": ".IntegrationTests", "mayReference": ["Api"] }
  ],
  "locations": {
    "domain model": "backend/*.Domain/",
    "use-case unit": "backend/*.Application/",
    "adapter": "backend/*.Infrastructure/",
    "persistence implementation": "backend/*.Infrastructure/Persistence/",
    "entry point": "backend/*.Api/",
    "composition root": "backend/*.Api/",
    "test-project role": "backend/*Tests/"
  }
}
