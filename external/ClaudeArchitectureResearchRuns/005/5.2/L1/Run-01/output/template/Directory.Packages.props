<!--
  Level: 3-project | Owns: NuGet Central Package Management versions (package-management.md).
  Add each PackageVersion through the add-dependency workflow with an explicit, verified,
  latest stable compatible version; project files keep versionless PackageReference entries.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
