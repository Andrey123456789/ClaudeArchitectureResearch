{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR??'.','.claude/hooks/dependency-guard.cjs'))\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR??'.','.claude/hooks/post-edit-check.cjs'))\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR??'.','.claude/hooks/stop-co-change.cjs'))\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)"
    ]
  }
}
