<!--
  Level: 3-project | Owns: genuinely shared .NET build settings (project stack: layout and build defaults).
  Project-specific settings stay in their own project files.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Surfaces .editorconfig code-style diagnostics (for example IDE0005 unused usings) in builds. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments are not required (documentation file is generated for IDE0005 analysis). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
