# Level: 3-project | Owns: deterministic repository-wide formatting and C# code-style configuration
# Policy context: .claude/rules/0-core/coding.md (follow .editorconfig; file-scoped namespaces;
# Async suffix) and the verify workflow (unused usings in changed files).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,csproj,props,targets,xml,html,scss,css,ts,js,mjs,cjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion
# Unused or redundant usings (IDE0005) surface in builds via EnforceCodeStyleInBuild
dotnet_diagnostic.IDE0005.severity = warning

# Type inference
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:silent

# Language features (clarity first; not enforced as errors)
csharp_style_prefer_primary_constructors = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Naming: PascalCase types and members, camelCase parameters/locals, Async suffix
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = suggestion

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = suggestion

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = suggestion

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_rule.locals_and_parameters_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_camel.style = camel_case
dotnet_naming_rule.locals_and_parameters_camel.severity = suggestion
