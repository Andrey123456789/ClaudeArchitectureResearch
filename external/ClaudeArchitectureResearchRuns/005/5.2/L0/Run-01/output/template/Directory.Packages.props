<Project>
  <!-- Level: 2 Technology | NuGet Central Package Management (enforcement asset).
       Owner rule: .claude/rules/2-technology/package-management.md. Procedure: add-dependency skill.
       Add <PackageVersion Include="..." Version="..." /> entries here with versions resolved at install
       time (latest stable compatible); project files keep versionless <PackageReference> entries. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
