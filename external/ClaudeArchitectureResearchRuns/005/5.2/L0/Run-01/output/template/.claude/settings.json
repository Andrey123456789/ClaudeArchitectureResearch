{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR||'.','.claude','hooks','dependency-guard.cjs'))\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR||'.','.claude','hooks','post-edit.cjs'))\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR||'.','.claude','hooks','stop-cochange.cjs'))\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
