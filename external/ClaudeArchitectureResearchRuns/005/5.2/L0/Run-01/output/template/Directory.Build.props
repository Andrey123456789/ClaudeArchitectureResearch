<Project>
  <!-- Level: 3 Project | Shared .NET build settings for every project under backend/ (scaffold asset).
       Owner rules: .claude/rules/3-project/decisions.md (platform, shared build files).
       Keep only genuinely shared settings here; project-specific settings stay in each .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
