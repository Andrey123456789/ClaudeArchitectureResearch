<!-- Shared .NET build settings for every project in the repository. Owner: docs/technology-stack.md (Backend Platform, Solution Layout). Project-specific settings stay in their own .csproj files. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
