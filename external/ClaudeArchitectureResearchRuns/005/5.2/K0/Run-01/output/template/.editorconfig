# Kind: ENF | Scope: common | Owns: deterministic formatting and code-style configuration | Loads: IDE, compiler and dotnet format
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,html,scss,css,js,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,xml,slnx}]
indent_size = 2

[*.cs]
# Namespaces and usings (rules/backend/csharp.md; changed-file using cleanup in verify)
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# Type inference and expression preferences
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:silent
csharp_style_prefer_primary_constructors = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Async naming: methods returning Task/ValueTask end with Async
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# Standard .NET naming
dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = suggestion
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, record, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
