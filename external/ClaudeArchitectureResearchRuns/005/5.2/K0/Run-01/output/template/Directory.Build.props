<!-- Kind: ENF | Scope: backend | Owns: shared .NET build settings (DEC-PLAT-01, DEC-BUILD-01) | Loads: MSBuild, every project under the repository -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
