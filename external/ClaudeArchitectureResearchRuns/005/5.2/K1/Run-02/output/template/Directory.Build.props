<!-- Kind: ENF | Scope: backend | Capability: — | Loading: MSBuild (every .NET project below this directory) -->
<!-- Genuinely shared .NET build settings only; project-specific settings stay in their projects (decision register). -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
