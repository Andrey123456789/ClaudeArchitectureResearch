<!-- Kind: ENF | Scope: backend | Capability: — | Loading: imported by MSBuild for every .NET project | Shared .NET build settings -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Report .editorconfig code-style diagnostics (for example IDE0005 unused usings) during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 to be reported on build; missing XML comments are not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
