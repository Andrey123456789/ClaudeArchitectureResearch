{
  "_header": "Kind: ENF | Scope: backend | Capability: architecture/clean-architecture | Loading: read by .claude/scripts/check-architecture.mjs and the Stop hook | Machine-readable copy of the dependency-direction standard",
  "owner": ".claude/rules/backend/architecture-style.md",
  "projectRoot": "backend",
  "roles": ["Domain", "Application", "Infrastructure", "Api"],
  "allowedReferences": {
    "Domain": [],
    "Application": ["Domain"],
    "Infrastructure": ["Application", "Domain"],
    "Api": ["Application", "Infrastructure", "Domain"]
  },
  "innerRoles": ["Domain", "Application"],
  "forbiddenFrameworkReferences": {
    "Domain": ["Microsoft.AspNetCore.App"],
    "Application": ["Microsoft.AspNetCore.App"]
  },
  "forbiddenSdks": {
    "Domain": ["Microsoft.NET.Sdk.Web"],
    "Application": ["Microsoft.NET.Sdk.Web"],
    "Infrastructure": ["Microsoft.NET.Sdk.Web"]
  },
  "testProjects": [
    { "suffix": ".IntegrationTests", "mayReference": ["Api", "Application", "Infrastructure", "Domain"] },
    { "suffix": ".Domain.Tests", "layer": "Domain" },
    { "suffix": ".Application.Tests", "layer": "Application" },
    { "suffix": ".Infrastructure.Tests", "layer": "Infrastructure" },
    { "suffix": ".Api.Tests", "layer": "Api" }
  ],
  "coChange": [
    {
      "id": "backend-tests",
      "when": ["backend/*/**/*.cs"],
      "exclude": ["backend/*Tests/**"],
      "unless": ["backend/*Tests/**"],
      "message": "Backend production code changed without test changes: confirm maintained coverage of the changed behavior (`verify` → 4. Preserve behavioral verification)."
    }
  ]
}
