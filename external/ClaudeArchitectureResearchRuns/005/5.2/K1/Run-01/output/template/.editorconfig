# Kind: ENF | Scope: common | Capability: — | Loading: read by editors, dotnet format and the .NET build | Formatting and code-style enforcement
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,xml,csproj,props,targets,slnx,html,scss,css,ts,js,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
# Unused or redundant using directives (reported on build through EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0005.severity = warning

# Language preferences
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:silent
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_prefer_braces = when_multiline:suggestion

# Naming: PascalCase types and members, I-prefixed interfaces, Async suffix for async methods
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_prefix
dotnet_naming_rule.interfaces_prefixed.severity = suggestion
dotnet_naming_rule.async_methods_suffixed.symbols = async_methods
dotnet_naming_rule.async_methods_suffixed.style = async_suffix
dotnet_naming_rule.async_methods_suffixed.severity = suggestion
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = suggestion
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = suggestion
